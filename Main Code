# SMART BARN MONITORING SYSTEM (COMBINED)
# ML + AUTO SENSOR + AUTO ALERT
# Using scikit-learn


import pandas as pd
import random
import time
from sklearn.tree import DecisionTreeClassifier

print("Smart Barn Monitoring System Started.\n")


# 1. TRAINING DATA (SIMULATED)

data = {
    "temperature": [22, 25, 28, 31, 34, 36, 38, 41],
    "humidity":    [45, 50, 60, 65, 72, 78, 85, 90],
    "gas":         [120, 150, 180, 220, 260, 300, 350, 420],
    "status":      [0, 0, 0, 1, 1, 1, 2, 2]  # 0=Safe, 1=Warning, 2=Danger
}

df = pd.DataFrame(data)

X = df[["temperature", "humidity", "gas"]]  # inputs
y = df["status"]                            # output


# 2. TRAIN ML MODEL

model = DecisionTreeClassifier(random_state=42)
model.fit(X, y)

print("ML Model Trained Successfully!\n")


# 3. AUTO MONITORING (DEMO LOOP)

for i in range(5):
    # Auto sensor values
    temperature = random.randint(20, 45)
    humidity    = random.randint(40, 90)
    gas         = random.randint(100, 450)

    # Convert to DataFrame (important to avoid error)
    input_data = pd.DataFrame(
        [[temperature, humidity, gas]],
        columns=["temperature", "humidity", "gas"]
    )

    prediction = model.predict(input_data)

    # Convert prediction to readable status
    if prediction[0] == 0:
        status = "SAFE "
    elif prediction[0] == 1:
        status = "WARNING "
    else:
        status = "DANGER "

    # Display result
    print("Temperature :", temperature, "°C")
    print("Humidity    :", humidity, "%")
    print("Gas Level   :", gas, "ppm")
    print("Barn Status :", status)
    print("--------------------------------")

    time.sleep(2)

print("\nMonitoring demo completed.")
